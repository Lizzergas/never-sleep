---
import { AppToggle } from "./AppToggle";

interface Props {
    "aria-label"?: string;
}

const { "aria-label": ariaLabel = "App preview" } = Astro.props;
---

<figure class="workbench-preview" aria-label={ariaLabel}>
    <div class="toggle-stage">
        <p class="toggle-stage__title">Keep screen on</p>
        <AppToggle client:visible />
    </div>
    <figcaption>Try the demo</figcaption>
</figure>
