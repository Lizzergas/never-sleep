---
import { AppToggle } from "./AppToggle";
interface Props { "aria-label"?: string; }
const { "aria-label": ariaLabel = "Interactive app preview" } = Astro.props;
---
<figure class="app-preview" aria-label={ariaLabel}>
    <AppToggle client:visible />
    <noscript><p class="hint">Enable JavaScript to try the ON and OFF control.</p></noscript>
</figure>
