---
import SiteLayout from "../layouts/SiteLayout.astro";
import GooglePlayBadge from "../components/ui/GooglePlayBadge.astro";
import AppToggleMock from "../components/AppToggleMock.astro";
---

<SiteLayout
    title="Keep your Android screen on | Never Sleep"
    description="Keep your screen on with one tap. Never Sleep for Android."
>
    <section class="landing-hero" aria-labelledby="page-title">
        <div class="hero-copy">
            <h1 id="page-title"><span class="headline-night">Never sleep.</span><br /><span class="headline-day">Always awake.</span></h1>
            <p class="lede">Keep your screen on with one tap.</p>
            <div class="actions">
                <GooglePlayBadge />
            </div>
        </div>
        <AppToggleMock aria-label="Try Never Sleep: tap the control to turn it on or off" />
    </section>

</SiteLayout>
