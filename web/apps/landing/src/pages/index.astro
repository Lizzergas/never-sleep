---
import SiteLayout from "../layouts/SiteLayout.astro";
import GooglePlayBadge from "../components/ui/GooglePlayBadge.astro";
import AppToggleMock from "../components/AppToggleMock.astro";

const description =
    "Prevent your screen from turning off due to inactivity. One tap to enable screen lock and you are good to go!";
---

<SiteLayout
    title="Never Sleep — Android screen timeout utility"
    description={description}
    showShader={true}
    showHeader={false}
>
    <section class="workbench-intro" aria-labelledby="page-title">
        <div class="workbench-intro__copy">
            <p class="product-kind">Android screen timeout utility</p>
            <h1 id="page-title">Never Sleep</h1>
            <p class="lede">{description}</p>
            <div class="actions" aria-label="Primary links">
                <GooglePlayBadge />
                <a class="text-link" href="/privacy">Read the privacy policy</a>
            </div>
        </div>

        <AppToggleMock aria-label="Interactive app preview" />
    </section>

    <section class="state-ledger" aria-labelledby="states-title">
        <div class="state-ledger__intro">
            <h2 id="states-title">Two states. One setting.</h2>
            <p>Switching back to Normal restores the timeout the device used before Never mode.</p>
        </div>
        <dl class="state-ledger__rows">
            <div data-state="normal">
                <dt>Normal</dt>
                <dd>Uses Android’s system screen timeout.</dd>
            </div>
            <div data-state="never">
                <dt>Never</dt>
                <dd>Keeps the screen awake until you switch back.</dd>
            </div>
        </dl>
    </section>

    <section class="control-map" aria-labelledby="controls-title">
        <header>
            <h2 id="controls-title">Built for quick control</h2>
            <p>Three ways to toggle — same simple idea: your screen stays awake only when you want it to.</p>
        </header>
        <ol class="control-list">
            <li>
                <span>App</span>
                <div>
                    <h3>One-tap toggle</h3>
                    <p>A large, clear button switches between Normal and Never mode.</p>
                </div>
            </li>
            <li>
                <span>Shade</span>
                <div>
                    <h3>Quick Settings tile</h3>
                    <p>Add the tile once, then toggle without opening the app.</p>
                </div>
            </li>
            <li>
                <span>Home</span>
                <div>
                    <h3>1×1 widget</h3>
                    <p>Keep the same control within reach on your launcher.</p>
                </div>
            </li>
        </ol>
    </section>

    <section class="download-close" aria-label="Download Never Sleep">
        <p>Never Sleep for Android</p>
        <GooglePlayBadge large />
    </section>
</SiteLayout>
